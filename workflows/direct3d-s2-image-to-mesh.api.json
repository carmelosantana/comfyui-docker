{
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "example-rgba.png"}
  },
  "2": {
    "class_type": "Direct3DS2ModelLoader",
    "inputs": {"version": "direct3d-s2-v-1-1"}
  },
  "3": {
    "class_type": "Direct3DS2ImageToMesh",
    "inputs": {
      "pipeline": ["2", 0],
      "image": ["1", 0],
      "mask": ["1", 1],
      "sdf_resolution": "1024",
      "seed": 6400,
      "dense_steps": 50,
      "dense_guidance": 7.0,
      "sparse_512_steps": 30,
      "sparse_512_guidance": 7.0,
      "sparse_1024_steps": 15,
      "sparse_1024_guidance": 7.0,
      "mc_threshold": 0.2,
      "remove_interior": true,
      "deterministic": false,
      "unload_after": true
    }
  },
  "4": {
    "class_type": "Direct3DS2SaveMesh",
    "inputs": {"mesh": ["3", 0], "filename_prefix": "3d/direct3d_s2", "format": "glb"}
  }
}
