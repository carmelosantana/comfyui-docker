# Copy to .env and adjust. All values have sane defaults in the compose files.
IMAGE_TAG=latest

# Host user/group that should own files created in the mounts (avoids root-owned files).
USER_ID=1000
GROUP_ID=1000

# Generic compose paths (default under ./data). For the 3090 sample these default to /mnt/Data/ComfyUI/*.
MODELS_PATH=./data/models
CUSTOM_NODES_PATH=./data/custom_nodes
OUTPUT_PATH=./data/output
INPUT_PATH=./data/input

# Port on the host.
COMFYUI_PORT=8188

# GPUs to reserve for the generic compose.
GPU_COUNT=1

# Torch 2.9 allocator tuning (cuts fragmentation OOMs on long video decodes).
PYTORCH_ALLOC_CONF=expandable_segments:True

# Opt-in: bootstrap the supported node packs into the mounted custom_nodes on first boot.
# (Wire-up is documented in the README; leave unset to skip.)
BOOTSTRAP_NODES=

# ComfyUI-Manager v4 posture (written to user/__manager/config.ini, ENFORCED every boot).
# personal_cloud + normal unlocks the install/model management API (ComfyUI-MCP) on a LAN box that
# listens on 0.0.0.0 — Manager blocks those actions for public/private/offline on a non-loopback
# listen, so personal_cloud is required (not public/private). normal is the least-permissive level
# that still allows arbitrary git-URL node installs and arbitrary-URL model downloads.
# Set MANAGER_NETWORK_MODE=public to LOCK DOWN when the box is exposed publicly.
MANAGER_NETWORK_MODE=personal_cloud
MANAGER_SECURITY_LEVEL=normal

# SageAttention (the -sage image tags only). The -sage image bakes this to 1 (sage attention on).
# Set to 0 to A/B against the default attention backend without a rebuild. Has NO effect on the
# base image (the sageattention package isn't installed there).
USE_SAGE_ATTENTION=1
