# Copy to .env and adjust. All values have sane defaults in the compose files.
IMAGE_TAG=latest

# Host user/group that should own files created in the mounts (avoids root-owned files).
USER_ID=1000
GROUP_ID=1000

# Generic compose paths (default under ./data). The 3090 sample compose files set their own host
# defaults; override any of these to point elsewhere.
MODELS_PATH=./data/models
CUSTOM_NODES_PATH=./data/custom_nodes
OUTPUT_PATH=./data/output
INPUT_PATH=./data/input
# Saved-workflows mount — used by the 3090 sample compose files (the generic compose does not mount it).
WORKFLOWS_PATH=./data/workflows

# Port on the host.
COMFYUI_PORT=8188

# GPUs to reserve for the generic compose.
GPU_COUNT=1

# Torch 2.9 allocator tuning (cuts fragmentation OOMs on long video decodes).
PYTORCH_ALLOC_CONF=expandable_segments:True

# Baked node packs (TTS/voice, Wan video + helpers, utilities) are seeded into custom_nodes on every
# boot and ON BY DEFAULT. Disable a category by setting its flag to 0, or SEED_BAKED_NODES=0 for none.
SEED_BAKED_NODES=1
SEED_AUDIO_NODES=1      # TTS-Audio-Suite
SEED_VIDEO_NODES=1      # WanVideoWrapper, VideoHelperSuite, Frame-Interpolation
SEED_HELPER_NODES=1     # KJNodes, essentials, HuggingFace Downloader

# Opt-in: git-clone EXTRA packs from scripts/node-manifest.txt on first boot (the supported packs are
# already baked in; this is only for adding your own). Leave unset to skip. Runtime clone, not baked.
BOOTSTRAP_NODES=

# ComfyUI-Manager v4 posture (written to user/__manager/config.ini, ENFORCED every boot).
# personal_cloud + normal unlocks the install/model management API (ComfyUI-MCP) on a LAN box that
# listens on 0.0.0.0 — Manager blocks those actions for public/private/offline on a non-loopback
# listen, so personal_cloud is required (not public/private). normal is the least-permissive level
# that still allows arbitrary git-URL node installs and arbitrary-URL model downloads.
# Set MANAGER_NETWORK_MODE=public to LOCK DOWN when the box is exposed publicly.
MANAGER_NETWORK_MODE=personal_cloud
MANAGER_SECURITY_LEVEL=normal

# SageAttention (the -sage image tags only). The -sage image bakes this to 1 (sage attention on).
# Set to 0 to A/B against the default attention backend without a rebuild. Has NO effect on the
# base image (the sageattention package isn't installed there).
USE_SAGE_ATTENTION=1

# Lazy-download cache for model weights (TTS engines, HuggingFace hub, torch hub). Defaults inside
# the models mount so first-use downloads persist across `docker compose down && up`. Only change
# these if you want the cache somewhere else that is ALSO persistent.
HF_HOME=/opt/comfyui/models/.cache/huggingface
TORCH_HOME=/opt/comfyui/models/.cache/torch
